{
  "expo": {
    "name": "Warsha",
    "slug": "Warsha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/warsha-current-approved-icon.png",
    "scheme": "warsha",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080808",
    "primaryColor": "#080808",
    "notification": {
      "icon": "./assets/images/warsha-current-approved-notification.png",
      "color": "#2FBF71"
    },
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "6c8fbcda-6bb2-40b2-b8db-3b0ce127525f"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#080808",
      "bundleIdentifier": "com.warsha.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "$GOOGLE_MAPS_IOS_RENDER_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/images/warsha-current-approved-adaptive-foreground.png",
        "monochromeImage": "./assets/images/warsha-current-approved-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.warsha.app",
      "config": {
        "googleMaps": {
          "apiKey": "$GOOGLE_MAPS_ANDROID_RENDER_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/warsha-current-approved-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/warsha-current-approved-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#080808",
          "dark": {
            "image": "./assets/images/warsha-current-approved-splash.png",
            "backgroundColor": "#080808"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Warsha to attach photos to your service request.",
          "cameraPermission": "Allow Warsha to take photos for booking messages.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Warsha uses the camera to capture your identity document during worker verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Warsha uses your location only while you are choosing an address, to place the map pin.",
          "locationWhenInUsePermission": "Warsha uses your location only while you are choosing an address, to place the map pin.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6c8fbcda-6bb2-40b2-b8db-3b0ce127525f"
    }
  }
}
