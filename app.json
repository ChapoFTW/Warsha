{
  "expo": {
    "name": "Warsha",
    "slug": "Warsha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/warsha-brand-icon.png",
    "scheme": "warsha",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#FFFFFF",
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "6c8fbcda-6bb2-40b2-b8db-3b0ce127525f"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/warsha-brand-adaptive-foreground.png",
        "monochromeImage": "./assets/images/warsha-brand-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/warsha-brand-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/warsha-brand-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Warsha to attach photos to your service request.",
          "cameraPermission": "Allow Warsha to take photos for booking messages.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
