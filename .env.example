# Client-safe Expo configuration. These values are bundled into the app.
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects issue a publishable key instead of an anon key. The
# client accepts either; set exactly one.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WPS-017 staff operations surface. Inert unless set to `enabled`: the guard
# refuses to open it and every operational call is refused client-side.
#
# It does NOT remove the code from the bundle — Expo Router bundles every route
# module either way. The operations code holds no secret and grants no access.
#
# This is defence in depth. Every operational action is authorized on the server
# by capability regardless of this flag, and turning it on grants nobody access.
EXPO_PUBLIC_ADMIN_SURFACE=

# Never add SUPABASE_SERVICE_ROLE_KEY to an Expo EXPO_PUBLIC_* variable.
# The admin platform has no service-role path: it uses the same anon key and the
# signed-in staff member's own session, gated by RLS and capability checks.

# ---------------------------------------------------------------------------
# The web surface (web/.env.local, and Vercel project settings)
#
# Next.js reads its own variables and will not see the EXPO_PUBLIC_* pair above.
# These name the same Supabase project and the same publishable key; only the
# variable name differs, because Next.js inlines NEXT_PUBLIC_* at build time.
#
# Vercel builds from this repository on every push to main, so a Vercel
# environment missing these ships a web app that renders and cannot reach
# Supabase. Set them in the Vercel project, not only here.
#
# Locally these belong in web/.env.local, which is gitignored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
